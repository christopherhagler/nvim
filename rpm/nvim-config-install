#!/usr/bin/env bash
# nvim-config-install — activate the bundled Neovim setup for the current user.
#
# Copies the offline payload (installed by the nvim-config RPM under
# /opt/nvim-config) into this user's home. Safe to re-run: it backs up an
# existing config and resets the plugin/tool directories to the packaged state.
set -euo pipefail

PREFIX="${NVIM_CONFIG_PREFIX:-/opt/nvim-config}"
CONFIG_SRC="$PREFIX/home/config/nvim"
DATA_SRC="$PREFIX/home/data/nvim"
CONFIG_DST="${XDG_CONFIG_HOME:-$HOME/.config}/nvim"
DATA_DST="${XDG_DATA_HOME:-$HOME/.local/share}/nvim"

if [ ! -d "$CONFIG_SRC" ] || [ ! -d "$DATA_SRC" ]; then
  echo "error: payload not found under $PREFIX — is the nvim-config RPM installed?" >&2
  exit 1
fi

if [ -d "$CONFIG_DST" ]; then
  backup="${CONFIG_DST}.bak.$(date +%Y%m%d_%H%M%S)"
  echo "[info] backing up existing config: $CONFIG_DST -> $backup"
  mv "$CONFIG_DST" "$backup"
fi

mkdir -p "$(dirname "$CONFIG_DST")" "$DATA_DST"
cp -a "$CONFIG_SRC" "$CONFIG_DST"

# Reset packaged subtrees; leave user-owned state (undo history, sessions,
# telescope history, …) untouched.
for d in lazy mason site; do
  rm -rf "${DATA_DST:?}/$d"
  cp -a "$DATA_SRC/$d" "$DATA_DST/$d"
done

# Relocate absolute paths baked in at build time (rpm/build-rpm.sh records the
# prefix): Mason's Python entry scripts and bash-debug-adapter's wrapper point
# into the build machine's synthetic HOME. Text files only (grep -I), and only
# those that contain the old prefix.
if [ -f "$DATA_SRC/.bake-prefix" ]; then
  old="$(head -1 "$DATA_SRC/.bake-prefix")"
  if [ -n "$old" ] && [ "$old" != "$DATA_DST" ]; then
    # Literal match: escape sed's regex and replacement metacharacters
    old_re=$(printf '%s' "$old" | sed 's/[][\\.*^$|]/\\&/g')
    new_rep=$(printf '%s' "$DATA_DST" | sed 's/[\\&|]/\\&/g')
    for d in lazy mason site; do
      # grep exits 1 when a tree has no match; that is not an error here
      { grep -rlIF --null -- "$old" "$DATA_DST/$d" 2>/dev/null || true; } \
        | xargs -0 -r sed -i "s|$old_re|$new_rep|g"
    done
  fi
fi

echo "[ ok ] Neovim setup activated for ${USER:-$(id -un)}"
echo ""
echo "Next steps:"
echo "  - Start a login shell (or 'source /etc/profile.d/nvim-config.sh') so"
echo "    nvim, node, and rg from $PREFIX/bin are on your PATH"
echo "  - Run: nvim"
