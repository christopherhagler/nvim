{
  "languageserver": {
    "typescript": {
      "command": "tsserver",
      "filetypes": ["typescript", "typescriptreact", "typescript.tsx"],
      "rootPatterns": ["package.json", "tsconfig.json", ".git"]
    },
    "angular": {
      "command": "ngserver",
      "filetypes": ["typescript", "html"],
      "rootPatterns": ["angular.json", ".git"]
    }
  },
  "suggest.noselect": true
}

